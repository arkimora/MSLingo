{
  "name": "mslingo",
  "version": "0.1.0",
  "description": "Offline Mongolian Sign Language learning app — content sourced from mnsl.mn",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:msl": "tsx scripts/validate-msl.ts",
    "sync:mnsl": "tsx scripts/sync-mnsl.ts",
    "sync:numbers": "tsx scripts/sync-numbers.ts",
    "extract:info": "tsx scripts/extract-info.ts"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "flexsearch": "^0.7.43",
    "framer-motion": "^11.11.11",
